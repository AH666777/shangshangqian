{
  "version": 1,
  "primaryKey": "_id",
  "title": "抽签记录表",
  "description": "每支签的抽签流水，成就系统与跨设备历史的统计数据源",
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "系统主键"
    },
    "openid": {
      "bsonType": "string",
      "description": "归属用户 openid"
    },
    "level": {
      "bsonType": "string",
      "description": "签文等级，如上上签 / 上吉签 / 中平签 / 蓄力签 / 锦鲤签"
    },
    "scene": {
      "bsonType": "string",
      "description": "场景 key：daily / exam / work / festival"
    },
    "title": {
      "bsonType": "string",
      "description": "签文标题"
    },
    "dateKey": {
      "bsonType": "string",
      "description": "抽签日期 YYYY-MM-DD（北京时间），按日统计用"
    },
    "hour": {
      "bsonType": "int",
      "description": "抽签小时 0-23（北京时间），时段类成就用"
    },
    "createdAt": {
      "bsonType": "long",
      "description": "抽签时间戳（毫秒）"
    }
  }
}